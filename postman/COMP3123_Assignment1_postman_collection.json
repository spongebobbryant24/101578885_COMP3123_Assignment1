{
  "info": {
    "name": "COMP3123 Assignment 1 — API & Ownership Tests",
    "description": "Run top-to-bottom using the Collection Runner. Set collection variable testPassword to your own strong test password (not a real password). Start with a fresh 15-minute rate-limit window. The collection sets unique usernames for each run and token IDs from successful responses. Tests for HTTP codes, errors, and ownership are included. Rate-limiting evidence must be tested separately by setting AUTH_RATE_LIMIT_MAX=3 and restarting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "userA",
      "value": "",
      "type": "string"
    },
    {
      "key": "emailA",
      "value": "",
      "type": "string"
    },
    {
      "key": "userB",
      "value": "",
      "type": "string"
    },
    {
      "key": "emailB",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenA",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenB",
      "value": "",
      "type": "string"
    },
    {
      "key": "eidA",
      "value": "",
      "type": "string"
    },
    {
      "key": "eidB",
      "value": "",
      "type": "string"
