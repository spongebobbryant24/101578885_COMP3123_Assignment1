      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Health and user A signup",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "A — signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/user/signup",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userA}}\",\n  \"email\": \"{{emailA}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set('userA', 'usera_' + suffix);",
                  "pm.collectionVariables.set('emailA', 'usera_' + suffix + '@example.com');",
                  "pm.collectionVariables.set('userB', 'userb_' + suffix);",
                  "pm.collectionVariables.set('emailB', 'userb_' + suffix + '@example.com');",
                  "if (!pm.collectionVariables.get('testPassword')) throw new Error('Set collection variable testPassword before running');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userIdA', pm.response.json().data.user._id);",
                  "pm.test('Password omitted', () => pm.expect(pm.response.text()).not.to.include('\\\"password\\\"'));"
                ]
              }
            }
          ]
        },
